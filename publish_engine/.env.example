DATABASE_URL="postgres://postgres:password@host:5433/base_dados"

# Production: PostgREST gateway, similar to Supabase REST with a service key.
# Keep this key server-side only. Never expose it to browser code.
PUBLISH_CONTROL_DATA_API_URL="https://pgapi.shprimenegocios.com.br"
# Accepts either the raw PGRST_JWT_SECRET or a ready JWT with role service_role.
PUBLISH_CONTROL_SERVICE_KEY=""

# Required in production for Vercel Cron calls to /api/publication/final/scheduled-refresh.
CRON_SECRET=""
